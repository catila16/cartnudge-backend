# CartNudge Production Environment Variables
# Copy these to your Railway / Supabase / Render dashboard variables.

# Database (PostgreSQL required for Prisma in production)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Async Database (If using SQLAlchemy Async with asyncpg)
# SYNC_DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Redis (Upstash) - For Celery and Caching
REDIS_URL="rediss://default:password@us1-upstash-redis.upstash.io:32000"

# Shopify Security & Billing
SHOPIFY_API_KEY="your_shopify_api_key_here"
SHOPIFY_API_SECRET="e6b26d80fcf80d98017367488fc0b551e080a1ad5276c0eb0c91367d6d7a32c1"

# LLM (OpenAI)
OPENAI_API_KEY="sk-your-openai-key-here"

# WhatsApp (Twilio / Meta API)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Host Config
API_BASE_URL="https://api.trycartnudge.com"
